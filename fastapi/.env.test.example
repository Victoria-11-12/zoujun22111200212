# ========================================
# 数据库配置
# ========================================

# MySQL 数据库主机地址
DB_HOST=127.0.0.1

# 数据库端口（本地环境默认 3306）
DB_PORT=3306

# 管理员数据库用户名
DB_USER=root

# 管理员数据库密码（请修改为你的本地数据库密码）
DB_PASS=your_password_here

# 数据库名称
DB_NAME=movie_db

# 只读数据库用户名（如未创建可使用 root）
DB_USER_READONLY=root

# 只读数据库密码
DB_PASS_READONLY=your_password_here

# 分析师数据库用户名（如未创建可使用 root）
DB_USER_ANALYST=root

# 分析师数据库密码
DB_PASS_ANALYST=your_password_here


# ========================================
# LLM API 配置
# ========================================

# API 基础地址
API_BASE=https://api.deepseek.com/v1

# API 密钥（请修改为你自己的 API 密钥）
API_KEY=your_api_key_here

# 对话模型名称
MODEL_NAME=deepseek-v4-flash


# ========================================
# 评估模型配置
# ========================================

# 评估模型 API 密钥（可与上面相同）
EVAL_API_KEY=your_api_key_here

# 评估模型名称
EVAL_MODEL_NAME=deepseek-v4-flash
