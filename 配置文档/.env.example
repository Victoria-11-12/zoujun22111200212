# ========================================
# 数据库配置
# ========================================

# MySQL 数据库主机地址
DB_HOST=localhost

# 数据库名称
DB_NAME=movie_db

# 管理员数据库用户名（读写权限，用于 FastAPI 和 Node.js）
DB_USER=root

# 管理员数据库密码
DB_PASS=your_password_here

# 只读数据库用户名（普通用户使用，用于 FastAPI，仅 movies 表只读）
DB_USER_READONLY=readonly_user

# 只读数据库密码
DB_PASS_READONLY=123456

# 分析师数据库用户（用于评估模块查询日志表和写入评估结果表）
DB_USER_ANALYST=analyst

# 分析师数据库密码
DB_PASS_ANALYST=123456


# ========================================
# LLM API 配置
# ========================================

# API 基础地址（支持 OpenAI 兼容的 API）
# DeepSeek: https://api.deepseek.com/v1
# OpenAI: https://api.openai.com/v1
# 其他兼容服务请填写对应的 API 地址
API_BASE=https://api.deepseek.com/v1

# API 密钥
API_KEY=your_api_key_here

# 对话模型名称
# DeepSeek: deepseek-v4-flash, deepseek-chat 等
# OpenAI: gpt-4, gpt-3.5-turbo 等
MODEL_NAME=deepseek-v4-flash


# ========================================
# 评估模型配置（数据分析师模块）
# ========================================

# 评估 API 密钥（可与上面 API_KEY 相同）
EVAL_API_KEY=your_eval_api_key_here

# 评估模型名称
# DeepSeek: deepseek-v4-flash, deepseek-reasoner 等
# OpenAI: gpt-4 等
EVAL_MODEL_NAME=deepseek-v4-flash


# ========================================
# JWT 配置（Node.js 服务）
# ========================================

# JWT 密钥（请使用随机字符串）
JWT_SECRET=your_jwt_secret_key_here

# JWT 过期时间（单位：小时，默认24小时）
JWT_EXPIRES_IN=24


# ========================================
# 服务端口配置（Docker 部署用）
# ========================================

# Node.js 服务端口
NODE_PORT=3000

# Flask 服务端口
FLASK_PORT=5000

# FastAPI 服务端口
FASTAPI_PORT=8000


# ========================================
# Docker 配置（CodeAct Agent 沙箱）
# ========================================

# Docker 镜像名称（用于 pyecharts 绘图沙箱）
DOCKER_IMAGE=pyecharts-sandbox

# Docker 内存限制（单位：MB）
DOCKER_MEMORY_LIMIT=256

# Docker 执行超时时间（单位：秒）
DOCKER_TIMEOUT=30


# 前端服务地址（用于 CORS 跨域配置和 ECharts 脚本加载）
# 格式：http://域名：端口 或 https://域名：端口
# 示例：http://localhost:3000 或 http://43.111.237.98:3000
FRONTEND_URL=http://localhost:3000

# FastAPI 后端服务地址（前端 JS 调用 AI/图表/评估等接口）
# 未配置时默认使用 http://localhost:8000，方便本地开发和 Docker 部署
FASTAPI_URL=http://localhost:8000

# Flask 预测服务地址（前端 JS 调用票房预测接口）
# 未配置时默认使用 http://localhost:5000，方便本地开发和 Docker 部署
FLASK_URL=http://localhost:5000
