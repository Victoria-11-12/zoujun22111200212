# ========================================
# FastAPI Agent 服务 Dockerfile
# 提供AI对话、智能分析和可视化功能
# ========================================

FROM python:3.10-slim

# 设置工作目录
WORKDIR /app

# 安装系统依赖
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# 复制依赖文件
COPY 配置文档/requirements.txt ./

# 安装Python依赖
RUN pip install --no-cache-dir -r requirements.txt

# 复制应用代码
COPY fastapi/ ./

# 暴露端口
EXPOSE 8000

# 启动命令
CMD ["python", "main.py"]
