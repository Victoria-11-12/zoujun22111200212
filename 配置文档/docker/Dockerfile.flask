# ========================================
# Flask 算法服务 Dockerfile
# 提供票房预测和机器学习功能
# ========================================

FROM python:3.10-slim

# 设置工作目录
WORKDIR /app

# 安装系统依赖
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# 复制依赖文件
COPY Flask/requirements.txt ./

# 安装Python依赖
RUN pip install --no-cache-dir -r requirements.txt

# 复制应用代码和模型文件
COPY Flask/ ./

# 暴露端口
EXPOSE 5000

# 启动命令
CMD ["python", "app2.py"]
