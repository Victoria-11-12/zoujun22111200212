# ========================================
# Node.js 业务服务 Dockerfile
# 提供前端页面和基础业务API
# ========================================

FROM node:18-alpine

# 设置工作目录
WORKDIR /app

# 复制package.json和package-lock.json
COPY Web_Node/package*.json ./

# 安装依赖
RUN npm install

# 复制应用代码
COPY Web_Node/ ./

# 暴露端口
EXPOSE 3000

# 启动命令
CMD ["node", "app.js"]
